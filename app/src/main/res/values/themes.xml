<resources>
    <style name="Theme.AklLive" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
    </style>

    <!-- the launch screen: the roundel on AT blue, then the app -->
    <style name="Theme.AklLive.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AklLive</item>
    </style>
</resources>
